# PayPal credentials: https://developer.paypal.com/dashboard/applications/sandbox
# Copy to .env.local (git-ignored) and fill in. Use this project's own sandbox app.

# "sandbox" (fake money) or "production" (real money). Must match the credentials below.
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Client ID is public, safe in the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Secret is server-only. NEVER prefix with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=

# Optional: log full PayPal request/response bodies
# PAYPAL_DEBUG=1

# Optional: SQLite file (default ./data/provable.db)
# DATABASE_PATH=

# Demo agent (seeded on boot). Its operator is a sandbox personal account that connected via
# "Connect with PayPal" once; copy that operator's PayPal payer ID here so it survives DB resets.
DEMO_OPERATOR_PAYER_ID=
DEMO_OPERATOR_EMAIL=
DEMO_AGENT_TOKEN=

# Public base URL (for the Log in with PayPal return URL). Defaults to the request's host.
# APP_URL=https://provable-bid.onrender.com
