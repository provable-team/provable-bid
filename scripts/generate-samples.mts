/**
 * Generates the public design samples (posters, business cards) with provable.bid's own house agents.
 *
 * It runs the same code the live service runs, imported from apps/api/src, without an API server or any records:
 *   1. Build: claudeHouseAgent (apps/api/src/claude.ts) with the real HOUSE_AGENTS profiles (identity.ts), which
 *      streams a page from Claude, runs the parse5 preflight (agent-preflight.ts) and at most one preflight repair,
 *      then "submits". Here uploadAsset/submit only capture the HTML locally. No waitForResult, so the agent makes a
 *      single qualification attempt (no judge-feedback revisions).
 *   2. Evaluate: inProcessEvaluation (runners.ts): the gates (html.ts gateHtml), a KERNEL render of the watermarked
 *      preview (browser.ts kernelRenderer: desktop 1280 + emulated 390 phone), then the Claude judge (claudeEvaluator, v2).
 *   3. Local print check (ours, not part of the live system): local Chrome, print media, page.pdf() with the page's
 *      own @page size, to read the printed page size and page count.
 *
 * Usage (keys from the environment only, never printed):
 *   set -a; . path/to/.env.local; set +a
 *   npx tsx scripts/generate-samples.mts                 # build + evaluate + print check, every brief x every agent
 *   npx tsx scripts/generate-samples.mts --only=<slug>   # one brief (comma-separated slugs, or slug/agent)
 *   npx tsx scripts/generate-samples.mts --print-check-only
 * Environment: ANTHROPIC_API_KEY, KERNEL_API_KEY (both required to build), CHROME_PATH (default /usr/bin/google-chrome).
 */
import Anthropic from '@anthropic-ai/sdk';
import { execFileSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { chromium } from 'playwright-core';
import type { AgentContext } from '../packages/agent-interface/src/index.js';
import type { components } from '../packages/api-client/src/schema.js';
import { kernelRenderer } from '../apps/api/src/browser.js';
import { claudeEvaluator, claudeHouseAgent, MAX_PREFLIGHT_REPAIRS } from '../apps/api/src/claude.js';
import { gateHtml, prepareHtml } from '../apps/api/src/html.js';
import { HOUSE_AGENTS } from '../apps/api/src/identity.js';
import { inProcessEvaluation, type EvaluationJob } from '../apps/api/src/runners.js';

type S = components['schemas'];
type Brief = {
  slug: string; fictional: boolean; kind: string; title: string; brief: string;
  print: { label: string; width_mm: number; height_mm: number; pages: number };
  requirements: S['Requirement'][];
};

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const SAMPLES = join(ROOT, 'samples');
const NOTE = 'Sample generated by provable.bid\'s house agents outside any buyer competition. No purchase, payout or buyer selection occurred. Fictional brief. Screen render only; print size/bleed not verified by KERNEL.';
const MAX_RETRIES = 1; // one more agent run when a build fails (preflight still failing after its repair, refusal, API error)

const args = process.argv.slice(2);
const only = args.find(a => a.startsWith('--only='))?.slice(7).split(',').filter(Boolean) ?? [];
const printOnly = args.includes('--print-check-only');
const selected = (slug: string, agent?: string) => !only.length || only.some(o => o === slug || (agent && o === `${slug}/${agent}`));

const git = (...a: string[]) => { try { return execFileSync('git', a, { cwd: ROOT, encoding: 'utf8' }).trim(); } catch { return null; } };
const briefs: Brief[] = JSON.parse(readFileSync(join(SAMPLES, 'briefs.json'), 'utf8')).briefs;
const slugOf = (name: string) => name.toLowerCase();

/** Counts Messages API calls made through one client, so provenance states exactly how many model calls an artifact took. */
function countingClient(apiKey: string) {
  const counter = { calls: 0 };
  const client = new Anthropic({ apiKey, fetch: async (input: string | URL | Request, init?: RequestInit) => {
    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
    if (/\/v1\/messages(\?|$)/.test(url)) counter.calls++;
    return fetch(input, init);
  } });
  return { client, counter };
}

type Provenance = Record<string, unknown> & { agent: string };

async function buildAndEvaluate(b: Brief, profile: (typeof HOUSE_AGENTS)[number], keys: { anthropic: string; kernel: string }, commit: { base: string | null; head: string | null; dirty: boolean }, kernelCount: { renders: number }): Promise<Provenance> {
  const agentSlug = slugOf(profile.name);
  const dir = join(SAMPLES, b.slug);
  mkdirSync(dir, { recursive: true });
  const competition = { id: `sample_${b.slug}`.slice(0, 64), title: b.title, brief: b.brief, requirements: b.requirements } as unknown as S['Competition'];
  const builder = countingClient(keys.anthropic);
  const attempts: { attempt: number; started_at: string; outcome: string; progress_steps: number }[] = [];
  let html: string | null = null;
  for (let attempt = 1; attempt <= 1 + MAX_RETRIES && html === null; attempt++) {
    let captured: string | null = null;
    let steps = 0;
    const started = Date.now();
    const deadline = started + 10 * 60_000;
    const ctx: AgentContext = {
      competition, signal: AbortSignal.timeout(10 * 60_000),
      // Local capture only: nothing is uploaded and no submission record exists anywhere.
      uploadAsset: async (asset) => { captured = Buffer.from(asset.content_base64, 'base64').toString('utf8'); return { id: 'local_asset' } as S['Asset']; },
      submit: async () => ({ id: 'local_submission' }) as S['Submission'],
      timeLeftMs: () => deadline - Date.now(),
      progress: () => { steps++; },
    };
    const agent = claudeHouseAgent(builder.client, profile);
    try {
      await agent.run(ctx);
      if (captured === null) throw new Error('agent finished without submitting');
      html = captured;
      attempts.push({ attempt, started_at: new Date(started).toISOString(), outcome: 'submitted', progress_steps: steps });
    } catch (e) {
      attempts.push({ attempt, started_at: new Date(started).toISOString(), outcome: `failed: ${(e as Error).message.slice(0, 600)}`, progress_steps: steps });
      console.log(`  ${b.slug}/${agentSlug}: attempt ${attempt} failed: ${(e as Error).message.slice(0, 200)}`);
    }
  }
  const judge = countingClient(keys.anthropic);
  const countedEvaluator = claudeEvaluator(judge.client);
  const base: Provenance = {
    agent: profile.name, agent_id: profile.id, agent_profile: { description: profile.description, style: profile.style },
    model: countedEvaluator.version.split(':')[1] ?? null,
    model_note: 'apps/api/src/claude.ts uses one MODEL constant (effort medium) for both the house-agent builder and the judge.',
    builder_version: `claudeHouseAgent (apps/api/src/claude.ts BUILDER_SYSTEM + agent-preflight.ts parse5 preflight, max ${MAX_PREFLIGHT_REPAIRS} preflight repair; single qualification attempt, no judge-feedback revision)`,
    evaluator_version: countedEvaluator.version,
    git: { base_commit: commit.base, generator_commit: commit.head, working_tree_dirty: commit.dirty },
    generated_at: new Date().toISOString(),
    build_attempts: attempts,
    note: NOTE,
  };
  if (html === null) return { ...base, status: 'build_failed', builder_model_calls: builder.counter.calls, judge_model_calls: 0, kernel_renders: 0 };

  const htmlFile = `${agentSlug}.html`;
  writeFileSync(join(dir, htmlFile), html);
  const prepared = prepareHtml(Buffer.from(html, 'utf8').toString('base64'));
  const gate = gateHtml(html);
  const job: EvaluationJob = {
    submission_id: `sample_${b.slug}_${agentSlug}`.slice(0, 64), title: b.title, brief: b.brief, requirements: b.requirements,
    artifact: { asset_id: 'local_asset', type: 'html', mime_type: 'text/html', size_bytes: prepared.original.length, sha256: prepared.sha256, width: null, height: null, preview: null } as unknown as S['Artifact'],
    original_base64: prepared.original.toString('base64'), preview_html: prepared.preview.toString('utf8'),
  };
  const renderer = kernelRenderer(keys.kernel);
  const countedRenderer = { name: renderer.name, render: (h: string, o?: Parameters<typeof renderer.render>[1]) => { kernelCount.renders++; return renderer.render(h, o); } };
  const outcome = await inProcessEvaluation({ renderer: countedRenderer, evaluator: countedEvaluator, log: (m, x) => console.log(`  ${m}`, x ?? '') }).evaluate(job, {
    onRendered: async (r) => {
      writeFileSync(join(dir, `${agentSlug}-desktop.jpg`), Buffer.from(r.desktop_base64, 'base64'));
      writeFileSync(join(dir, `${agentSlug}-phone.jpg`), Buffer.from(r.phone_base64, 'base64'));
    },
  });
  const r = outcome.rendered;
  return {
    ...base,
    status: outcome.result.status,
    file: htmlFile, sha256: prepared.sha256, size_bytes: prepared.original.length, title: prepared.title,
    gate: gate ? { passed: false, ...gate } : { passed: true, version: 'gates-v1' },
    render: r ? {
      renderer: r.renderer, note: 'KERNEL renders the watermarked preview (screen media only), exactly as for live entries.',
      desktop_screenshot: `${agentSlug}-desktop.jpg`, phone_screenshot: `${agentSlug}-phone.jpg`,
      desktop_height: r.desktopHeight, phone_height: r.phoneHeight, phone_overflow_px: r.phoneOverflowPx, phone_layout: r.phoneLayout ?? null,
      console_errors: r.consoleErrors, blocked_requests: r.blockedRequests, focus: r.focus ?? null, load_ms: r.loadMs ?? null, render_ms: r.renderMs ?? null,
    } : null,
    judge: {
      status: outcome.result.status, qualified: outcome.result.status === 'qualified', failure_code: outcome.result.failure_code,
      reason: outcome.result.reason, checks: outcome.result.checks, narrative: outcome.result.narrative ?? null,
      evaluator_version: outcome.result.evaluator_version,
    },
    builder_model_calls: builder.counter.calls, judge_model_calls: judge.counter.calls, kernel_renders: r ? 1 : 0,
  };
}

/** Our local print check: Chrome with print media, PDF at the page's own @page size; reads page boxes from the PDF. */
async function printCheck(b: Brief, entries: Provenance[]) {
  const browser = await chromium.launch({ executablePath: process.env.CHROME_PATH ?? '/usr/bin/google-chrome', headless: true });
  try {
    for (const p of entries) {
      const file = p.file as string | undefined;
      if (!file || !existsSync(join(SAMPLES, b.slug, file))) continue;
      const page = await browser.newPage();
      await page.route('**/*', route => route.request().url().startsWith('data:') || route.request().url() === 'about:blank' ? route.continue() : route.abort());
      await page.setContent(readFileSync(join(SAMPLES, b.slug, file), 'utf8'), { waitUntil: 'load' });
      await page.emulateMedia({ media: 'print' });
      const pdf = await page.pdf({ preferCSSPageSize: true, printBackground: true });
      await page.close();
      const text = pdf.toString('latin1');
      const boxes = [...text.matchAll(/\/MediaBox\s*\[\s*([\d.\-]+)\s+([\d.\-]+)\s+([\d.\-]+)\s+([\d.\-]+)\s*\]/g)]
        .map(m => [Number(m[3]) - Number(m[1]), Number(m[4]) - Number(m[2])]);
      const pages = (text.match(/\/Type\s*\/Page(?![s\w])/g) ?? []).length;
      const mm = (pt: number) => Math.round(pt * 25.4 / 72 * 10) / 10;
      const sizes = [...new Set(boxes.map(([w, h]) => `${mm(w)}x${mm(h)}`))];
      const [w, h] = boxes[0] ?? [0, 0];
      const sizeOk = boxes.length > 0 && boxes.every(([bw, bh]) => Math.abs(mm(bw) - b.print.width_mm) <= 1 && Math.abs(mm(bh) - b.print.height_mm) <= 1);
      p.print_check = {
        by: 'local Chrome (playwright-core page.pdf, emulateMedia print, preferCSSPageSize) run by the sample generator; not part of the live provable.bid pipeline',
        expected: { ...b.print },
        page_size_mm: boxes.length ? [mm(w), mm(h)] : null, distinct_page_sizes_mm: sizes, pages,
        size_matches: sizeOk, pages_match: pages === b.print.pages,
        checked_at: new Date().toISOString(),
        caveat: 'Checks the printed page box and page count only; not bleed, colour or whether artwork fills the page.',
      };
      console.log(`  print ${b.slug}/${file}: ${sizes.join(', ')} mm, ${pages} page(s) (expected ${b.print.width_mm}x${b.print.height_mm}, ${b.print.pages})`);
    }
  } finally { await browser.close(); }
}

async function main() {
  const commit = { base: git('rev-parse', 'b6468bc'), head: git('rev-parse', 'HEAD'), dirty: !!git('status', '--porcelain', '--', 'apps', 'packages', 'scripts') };
  const kernelCount = { renders: 0 };
  if (!printOnly) {
    const anthropic = process.env.ANTHROPIC_API_KEY, kernel = process.env.KERNEL_API_KEY;
    if (!anthropic || !kernel) throw new Error('ANTHROPIC_API_KEY and KERNEL_API_KEY must be set (they are read from the environment only).');
    const jobs = briefs.flatMap(b => HOUSE_AGENTS.filter(h => selected(b.slug, slugOf(h.name))).map(h => ({ b, h })));
    const results = new Map<string, Provenance[]>();
    let next = 0;
    const worker = async () => {
      while (next < jobs.length) {
        const { b, h } = jobs[next++];
        console.log(`build ${b.slug}/${h.name}`);
        const p = await buildAndEvaluate(b, h, { anthropic, kernel }, commit, kernelCount).catch(e => ({ agent: h.name, status: 'error', error: (e as Error).message.slice(0, 600), note: NOTE }) as Provenance);
        console.log(`done  ${b.slug}/${h.name}: ${p.status}`);
        results.set(b.slug, [...(results.get(b.slug) ?? []), p]);
      }
    };
    await Promise.all(Array.from({ length: 6 }, worker));
    for (const [slug, entries] of results) {
      const b = briefs.find(x => x.slug === slug)!;
      const file = join(SAMPLES, slug, 'provenance.json');
      const previous: Provenance[] = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')).artifacts : [];
      const merged = [...previous.filter(p => !entries.some(e => e.agent === p.agent)), ...entries].sort((x, y) => x.agent.localeCompare(y.agent));
      writeFileSync(file, `${JSON.stringify({ brief: b, note: NOTE, artifacts: merged }, null, 2)}\n`);
    }
    console.log(`KERNEL renders this run: ${kernelCount.renders}`);
  }
  for (const b of briefs.filter(x => selected(x.slug))) {
    const file = join(SAMPLES, b.slug, 'provenance.json');
    if (!existsSync(file)) continue;
    const doc = JSON.parse(readFileSync(file, 'utf8'));
    await printCheck(b, doc.artifacts);
    writeFileSync(file, `${JSON.stringify(doc, null, 2)}\n`);
  }
}

main().catch(e => { console.error(e); process.exit(1); });
