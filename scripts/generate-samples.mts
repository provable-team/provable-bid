/**
 * Generates the public design samples (posters, business cards) with provable.bid's own house agents.
 *
 * It runs the same code the live service runs, imported from apps/api/src, without an API server or any records:
 *   1. Build: claudeHouseAgent (apps/api/src/claude.ts) with the real HOUSE_AGENTS profiles (identity.ts), which
 *      streams a page from Claude, runs the parse5 preflight (agent-preflight.ts) and at most one preflight repair,
 *      then "submits". Here uploadAsset/submit only capture the HTML locally. No waitForResult, so the agent makes a
 *      single qualification attempt (no judge-feedback revisions).
 *   2. Evaluate: inProcessEvaluation (runners.ts): the gates (html.ts gateHtml), a KERNEL render of the watermarked
 *      preview (browser.ts kernelRenderer: desktop 1280 + emulated 390 phone), then the Claude judge (claudeEvaluator, v2).
 *   3. Local print check (ours, not part of the live system): local Chrome, print media, page.pdf() with the page's
 *      own @page size, to read the printed page size and page count.
 *
 * Usage (keys from the environment only, never printed):
 *   set -a; . path/to/.env.local; set +a
 *   npx tsx scripts/generate-samples.mts                 # build + evaluate + print check, every brief x every agent
 *   npx tsx scripts/generate-samples.mts --only=<slug>   # one brief (comma-separated slugs, or slug/agent)
 *   npx tsx scripts/generate-samples.mts --print-check-only
 * Environment: ANTHROPIC_API_KEY, KERNEL_API_KEY (both required to build), CHROME_PATH (default /usr/bin/google-chrome).
 */
import Anthropic from '@anthropic-ai/sdk';
import { execFileSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { chromium } from 'playwright-core';
import type { AgentContext } from '../packages/agent-interface/src/index.js';
import type { components } from '../packages/api-client/src/schema.js';
import { kernelRenderer } from '../apps/api/src/browser.js';
import { preflightHouseHtml } from '../apps/api/src/agent-preflight.js';
import { claudeEvaluator, claudeGenerator, MAX_HOUSE_ATTEMPTS, MAX_PREFLIGHT_REPAIRS, streamingHouseAgent, type PageGenerator } from '../apps/api/src/claude.js';
import { gateHtml, prepareHtml } from '../apps/api/src/html.js';
import { HOUSE_AGENTS } from '../apps/api/src/identity.js';
import { inProcessEvaluation, type EvaluationJob } from '../apps/api/src/runners.js';

type S = components['schemas'];
type Brief = {
  slug: string; fictional: boolean; kind: string; title: string; brief: string;
  print: { label: string; width_mm: number; height_mm: number; pages: number };
  requirements: S['Requirement'][];
};

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const SAMPLES = join(ROOT, 'samples');
const NOTE = 'Sample generated by provable.bid\'s house agents outside any buyer competition. No purchase, payout or buyer selection occurred. Fictional brief. Screen render only; print size/bleed not verified by KERNEL.';
/** This run's folder under samples/<slug>/. The first run (v1) stays at samples/<slug>/ itself, untouched. */
const RUN = 'v2';

const args = process.argv.slice(2);
const only = args.find(a => a.startsWith('--only='))?.slice(7).split(',').filter(Boolean) ?? [];
const checksOnly = args.includes('--local-checks-only') || args.includes('--print-check-only');
const selected = (slug: string, agent?: string) => !only.length || only.some(o => o === slug || (agent && o === `${slug}/${agent}`));

const git = (...a: string[]) => { try { return execFileSync('git', a, { cwd: ROOT, encoding: 'utf8' }).trim(); } catch { return null; } };
const briefs: Brief[] = JSON.parse(readFileSync(join(SAMPLES, 'briefs.json'), 'utf8')).briefs;
const slugOf = (name: string) => name.toLowerCase();

/** Counts Messages API calls made through one client, so provenance states exactly how many model calls an artifact took. */
function countingClient(apiKey: string, kind: 'builder' | 'judge') {
  const counter = { calls: 0 };
  const client = new Anthropic({ apiKey, fetch: async (input: string | URL | Request, init?: RequestInit) => {
    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
    if (/\/v1\/messages(\?|$)/.test(url)) { counter.calls++; used[kind]++; }
    return fetch(input, init);
  } });
  return { client, counter };
}

type Provenance = Record<string, unknown> & { agent: string };

/**
 * Shared sample budget across all parallel agents. The first attempt of every agent is always evaluated; a judge-feedback
 * revision is allowed only while a KERNEL render and a judge call are still free, and a new generation (revision or
 * preflight repair) only while builder calls are left. When it is spent, the agent sees no time left and stops revising,
 * exactly as a live agent does at its deadline. Every stop is recorded.
 */
const BUDGET = { builder: 40, judge: 40, kernel: 30 };
const used = { builder: 0, judge: 0, kernelReserved: 0, kernel: 0 };

async function buildAndEvaluate(b: Brief, profile: (typeof HOUSE_AGENTS)[number], keys: { anthropic: string; kernel: string }, commit: { base: string | null; head: string | null; dirty: boolean }): Promise<Provenance> {
  const agentSlug = slugOf(profile.name);
  const dir = join(SAMPLES, b.slug, RUN);
  mkdirSync(dir, { recursive: true });
  const competition = { id: `sample_${b.slug}`.slice(0, 64), title: b.title, brief: b.brief, requirements: b.requirements } as unknown as S['Competition'];
  const builder = countingClient(keys.anthropic, 'builder');
  const judge = countingClient(keys.anthropic, 'judge');
  const evaluator = claudeEvaluator(judge.client);
  const renderer = kernelRenderer(keys.kernel);
  const countedRenderer = { name: renderer.name, render: (h: string, o?: Parameters<typeof renderer.render>[1]) => { used.kernel++; return renderer.render(h, o); } };
  const runner = inProcessEvaluation({ renderer: countedRenderer, evaluator, log: (m, x) => console.log(`  ${m}`, x ?? '') });

  // Every generation the agent makes (first page, preflight repair, judge-feedback revision), with what the preflight said.
  const generations: { kind: string; stop_reason: string | null; preflight_issues: string[]; preflight_warnings: string[] }[] = [];
  const realGenerate = claudeGenerator(builder.client);
  const generate: PageGenerator = async (ctx, p, onText, revision) => {
    const out = await realGenerate(ctx, p, onText, revision);
    const pf = preflightHouseHtml(out.text, out.stopReason);
    generations.push({ kind: !revision ? 'first page' : revision.source === 'preflight' ? 'preflight repair' : 'judge-feedback revision', stop_reason: out.stopReason, preflight_issues: pf.issues, preflight_warnings: pf.warnings });
    return out;
  };

  const attempts: Record<string, unknown>[] = [];
  let captured: string | null = null;
  let stoppedBy: string | null = null;
  const started = Date.now();
  const deadline = started + 30 * 60_000;
  const budgetLeft = () => used.builder < BUDGET.builder - 2; // room for a generation plus its possible repair, with parallel agents
  const ctx: AgentContext = {
    competition, signal: AbortSignal.timeout(30 * 60_000),
    // Local capture only: nothing is uploaded and no submission record exists anywhere.
    uploadAsset: async (asset) => { captured = Buffer.from(asset.content_base64, 'base64').toString('utf8'); return { id: 'local_asset' } as S['Asset']; },
    submit: async () => ({ id: `local_submission_${attempts.length + 1}` }) as S['Submission'],
    timeLeftMs: () => stoppedBy || !budgetLeft() ? (stoppedBy ??= 'sample builder-call budget', 0) : deadline - Date.now(),
    progress: () => {},
    // As the live runner does: wait for this entry's own check and hand the agent the result, which drives its revision.
    waitForResult: async (submissionId) => {
      const html = captured!;
      const n = attempts.length + 1;
      const file = `${agentSlug}-attempt-${n}.html`;
      writeFileSync(join(dir, file), html);
      const prepared = prepareHtml(Buffer.from(html, 'utf8').toString('base64'));
      const gate = gateHtml(html);
      const job: EvaluationJob = {
        submission_id: `sample_${b.slug}_${agentSlug}_${n}`.slice(0, 64), title: b.title, brief: b.brief, requirements: b.requirements,
        artifact: { asset_id: 'local_asset', type: 'html', mime_type: 'text/html', size_bytes: prepared.original.length, sha256: prepared.sha256, width: null, height: null, preview: null } as unknown as S['Artifact'],
        original_base64: prepared.original.toString('base64'), preview_html: prepared.preview.toString('utf8'),
      };
      const outcome = await runner.evaluate(job, {
        onRendered: async (r) => {
          writeFileSync(join(dir, `${agentSlug}-attempt-${n}-desktop.jpg`), Buffer.from(r.desktop_base64, 'base64'));
          writeFileSync(join(dir, `${agentSlug}-attempt-${n}-phone.jpg`), Buffer.from(r.phone_base64, 'base64'));
        },
      });
      const r = outcome.rendered;
      attempts.push({
        attempt: n, file, sha256: prepared.sha256, size_bytes: prepared.original.length, title: prepared.title,
        gate: gate ? { passed: false, ...gate } : { passed: true, version: 'gates-v1' },
        render: r ? {
          renderer: r.renderer, note: 'KERNEL renders the watermarked preview (screen media only), exactly as for live entries.',
          desktop_screenshot: `${agentSlug}-attempt-${n}-desktop.jpg`, phone_screenshot: `${agentSlug}-attempt-${n}-phone.jpg`,
          desktop_height: r.desktopHeight, phone_height: r.phoneHeight, phone_overflow_px: r.phoneOverflowPx, phone_layout: r.phoneLayout ?? null,
          console_errors: r.consoleErrors, blocked_requests: r.blockedRequests, focus: r.focus ?? null, load_ms: r.loadMs ?? null, render_ms: r.renderMs ?? null,
        } : null,
        judge: {
          status: outcome.result.status, qualified: outcome.result.status === 'qualified', failure_code: outcome.result.failure_code,
          reason: outcome.result.reason, checks: outcome.result.checks, narrative: outcome.result.narrative ?? null,
          evaluator_version: outcome.result.evaluator_version,
        },
        evaluated_at: new Date().toISOString(),
      });
      console.log(`  ${b.slug}/${agentSlug} attempt ${n}: ${outcome.result.status}`);
      // A revision needs one more KERNEL render and judge call: reserve them now or tell the agent there is no time left.
      if (outcome.result.status === 'failed' && n < MAX_HOUSE_ATTEMPTS) {
        if (used.kernelReserved < BUDGET.kernel && used.judge < BUDGET.judge && budgetLeft()) used.kernelReserved++;
        else stoppedBy = 'sample KERNEL/judge budget';
      }
      return { id: submissionId, qualification_status: outcome.result.status, qualification: { ...outcome.result, artifact_hashes: [prepared.sha256] } } as unknown as S['Submission'];
    },
  };
  let error: string | null = null;
  try { await streamingHouseAgent(profile, generate).run(ctx); }
  catch (e) { error = (e as Error).message.slice(0, 600); console.log(`  ${b.slug}/${agentSlug}: ${error.slice(0, 200)}`); }

  // The last attempt is the entry that stands (earlier ones failed and were superseded); give it the plain file names.
  const last = attempts.at(-1) as (Record<string, any> | undefined);
  if (last) {
    const rename = (from: string, to: string) => { if (existsSync(join(dir, from))) { renameSync(join(dir, from), join(dir, to)); } };
    rename(last.file, `${agentSlug}.html`); last.file = `${agentSlug}.html`;
    if (last.render) {
      rename(last.render.desktop_screenshot, `${agentSlug}-desktop.jpg`); last.render.desktop_screenshot = `${agentSlug}-desktop.jpg`;
      rename(last.render.phone_screenshot, `${agentSlug}-phone.jpg`); last.render.phone_screenshot = `${agentSlug}-phone.jpg`;
    }
  }
  const failedLast = last?.judge?.status === 'failed';
  return {
    agent: profile.name, agent_id: profile.id, agent_profile: { description: profile.description, style: profile.style },
    model: evaluator.version.split(':')[1] ?? null,
    model_note: 'apps/api/src/claude.ts uses one MODEL constant (effort medium) for both the house-agent builder and the judge.',
    builder_version: `claudeHouseAgent (apps/api/src/claude.ts BUILDER_SYSTEM + agent-preflight.ts parse5 preflight with layout warnings, max ${MAX_PREFLIGHT_REPAIRS} preflight repair per run; judge-feedback revisions through waitForResult, up to ${MAX_HOUSE_ATTEMPTS} qualification attempts, as live)`,
    evaluator_version: evaluator.version,
    git: { base_commit: commit.base, generator_commit: commit.head, working_tree_dirty: commit.dirty },
    run: RUN,
    started_at: new Date(started).toISOString(),
    generated_at: (last?.evaluated_at as string | undefined) ?? new Date().toISOString(),
    status: error && !last ? 'build_failed' : last?.judge?.status ?? 'error',
    error,
    revision_stopped_by: failedLast && attempts.length < MAX_HOUSE_ATTEMPTS ? stoppedBy ?? 'agent stopped (see error)' : null,
    attempts_used: attempts.length,
    generations,
    // The standing entry, flattened as in v1 so the two runs compare field by field.
    ...(last ? { file: last.file, sha256: last.sha256, size_bytes: last.size_bytes, title: last.title, gate: last.gate, render: last.render, judge: last.judge } : {}),
    attempts,
    builder_model_calls: builder.counter.calls, judge_model_calls: judge.counter.calls, kernel_renders: attempts.filter(a => a.render).length,
    note: NOTE,
  };
}

/** Our local print check: Chrome with print media, PDF at the page's own @page size; reads page boxes from the PDF. */
async function localChecks(b: Brief, dir: string, entries: Provenance[]) {
  const browser = await chromium.launch({ executablePath: process.env.CHROME_PATH ?? '/usr/bin/google-chrome', headless: true });
  try {
    for (const p of entries) {
      const file = p.file as string | undefined;
      if (!file || !existsSync(join(dir, file))) continue;
      const page = await browser.newPage();
      await page.route('**/*', route => route.request().url().startsWith('data:') || route.request().url() === 'about:blank' ? route.continue() : route.abort());
      await page.setContent(readFileSync(join(dir, file), 'utf8'), { waitUntil: 'load' });
      await page.emulateMedia({ media: 'print' });
      const pdf = await page.pdf({ preferCSSPageSize: true, printBackground: true });
      await page.close();
      const text = pdf.toString('latin1');
      const boxes = [...text.matchAll(/\/MediaBox\s*\[\s*([\d.\-]+)\s+([\d.\-]+)\s+([\d.\-]+)\s+([\d.\-]+)\s*\]/g)]
        .map(m => [Number(m[3]) - Number(m[1]), Number(m[4]) - Number(m[2])]);
      const pages = (text.match(/\/Type\s*\/Page(?![s\w])/g) ?? []).length;
      const mm = (pt: number) => Math.round(pt * 25.4 / 72 * 10) / 10;
      const sizes = [...new Set(boxes.map(([w, h]) => `${mm(w)}x${mm(h)}`))];
      const [w, h] = boxes[0] ?? [0, 0];
      const sizeOk = boxes.length > 0 && boxes.every(([bw, bh]) => Math.abs(mm(bw) - b.print.width_mm) <= 1 && Math.abs(mm(bh) - b.print.height_mm) <= 1);
      p.print_check = {
        by: 'local Chrome (playwright-core page.pdf, emulateMedia print, preferCSSPageSize) run by the sample generator; not part of the live provable.bid pipeline',
        expected: { ...b.print },
        page_size_mm: boxes.length ? [mm(w), mm(h)] : null, distinct_page_sizes_mm: sizes, pages,
        size_matches: sizeOk, pages_match: pages === b.print.pages,
        checked_at: new Date().toISOString(),
        caveat: 'Checks the printed page box and page count only; not bleed, colour or whether artwork fills the page.',
      };
      console.log(`  print ${b.slug}/${file}: ${sizes.join(', ')} mm, ${pages} page(s) (expected ${b.print.width_mm}x${b.print.height_mm}, ${b.print.pages})`);
    }
  } finally { await browser.close(); }
}

/** What the first run (v1, at samples/<slug>/provenance.json, left untouched) produced, for the comparison. */
function previousRun(slug: string) {
  const file = join(SAMPLES, slug, 'provenance.json');
  if (!existsSync(file)) return null;
  const doc = JSON.parse(readFileSync(file, 'utf8'));
  return {
    run: 'v1', provenance: '../provenance.json',
    how: 'Previous builder prompt and preflight; one qualification attempt per agent, no judge-feedback revision (no waitForResult).',
    artifacts: (doc.artifacts as Provenance[]).map(a => ({
      agent: a.agent, file: `../${a.file}`, sha256: a.sha256, status: a.status, attempts_used: 1,
      failed_checks: ((a.judge as { checks?: { requirement_id: string; passed: boolean; reason: string }[] } | undefined)?.checks ?? []).filter(c => !c.passed),
      print_check: a.print_check ?? null,
    })),
  };
}

async function main() {
  const commit = { base: git('rev-parse', 'b6468bc'), head: git('rev-parse', 'HEAD'), dirty: !!git('status', '--porcelain', '--', 'apps', 'packages', 'scripts') };
  if (!checksOnly) {
    const anthropic = process.env.ANTHROPIC_API_KEY, kernel = process.env.KERNEL_API_KEY;
    if (!anthropic || !kernel) throw new Error('ANTHROPIC_API_KEY and KERNEL_API_KEY must be set (they are read from the environment only).');
    const jobs = briefs.flatMap(b => HOUSE_AGENTS.filter(h => selected(b.slug, slugOf(h.name))).map(h => ({ b, h })));
    used.kernelReserved = jobs.length; // every first attempt is evaluated
    const results = new Map<string, Provenance[]>();
    await Promise.all(jobs.map(async ({ b, h }) => {
      console.log(`build ${b.slug}/${h.name}`);
      const p = await buildAndEvaluate(b, h, { anthropic, kernel }, commit).catch(e => ({ agent: h.name, status: 'error', error: (e as Error).message.slice(0, 600), note: NOTE }) as Provenance);
      console.log(`done  ${b.slug}/${h.name}: ${p.status} after ${p.attempts_used ?? 0} attempt(s)`);
      results.set(b.slug, [...(results.get(b.slug) ?? []), p]);
    }));
    for (const [slug, entries] of results) {
      const b = briefs.find(x => x.slug === slug)!;
      const file = join(SAMPLES, slug, RUN, 'provenance.json');
      const previous: Provenance[] = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')).artifacts : [];
      const merged = [...previous.filter(p => !entries.some(e => e.agent === p.agent)), ...entries].sort((x, y) => x.agent.localeCompare(y.agent));
      writeFileSync(file, `${JSON.stringify({ brief: b, run: RUN, note: NOTE, previous_runs: [previousRun(slug)].filter(Boolean), artifacts: merged }, null, 2)}\n`);
    }
    console.log(`Model calls: builder ${used.builder}, judge ${used.judge}; KERNEL renders ${used.kernel}`);
  }
  for (const b of briefs.filter(x => selected(x.slug))) {
    const file = join(SAMPLES, b.slug, RUN, 'provenance.json');
    if (!existsSync(file)) continue;
    const doc = JSON.parse(readFileSync(file, 'utf8'));
    await localChecks(b, join(SAMPLES, b.slug, RUN), doc.artifacts);
    for (const run of doc.previous_runs ?? []) await localChecks(b, join(SAMPLES, b.slug, RUN), run.artifacts);
    writeFileSync(file, `${JSON.stringify(doc, null, 2)}\n`);
  }
}

main().catch(e => { console.error(e); process.exit(1); });
