{
  "name": "provable-contracts",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "contracts:lint": "redocly lint contracts/openapi.yaml",
    "client:generate": "openapi-typescript contracts/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "client:check": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run contracts:lint && npm run client:check && npm run typecheck && npm test",
    "web:dev": "npm run dev --workspace=@provable/web",
    "web:build": "npm run build --workspace=@provable/web",
    "web:check": "npm run typecheck --workspace=@provable/web && npm test --workspace=@provable/web",
    "api": "tsx --env-file-if-exists=.env.local apps/api/src/server.ts",
    "api:fake": "PAYMENTS=fake tsx apps/api/src/server.ts",
    "api:build": "esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/api-server.mjs",
    "api:start": "node dist/api-server.mjs",
    "workflows:dev": "render workflows dev -- npx tsx apps/api/src/workflows/main.ts",
    "workflows:build": "esbuild apps/api/src/workflows/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/workflows.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.77.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  },
  "overrides": {
    "mathjs": "^15.2.0"
  }
}
